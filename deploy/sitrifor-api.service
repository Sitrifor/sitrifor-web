[Unit]
Description=Sitrifor API (promo codes)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/sitrifor/backend
Environment=NODE_ENV=production
Environment=PORT=8081
Environment=HOST=127.0.0.1
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
