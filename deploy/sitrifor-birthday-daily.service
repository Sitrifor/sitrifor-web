[Unit]
Description=Sitrifor daily birthday luck-tattoo articles (throttled LLM)
After=network-online.target ollama.service sitrifor-api.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/var/www/sitrifor/seo
Environment=OLLAMA_HOST=http://127.0.0.1:11434
Environment=OLLAMA_MODEL=qwen2.5:1.5b
Environment=OLLAMA_NUM_THREAD=1
Environment=OLLAMA_NUM_CTX=2048
Environment=NEWS_BIRTHDAY_DAILY_COUNT=10
Environment=NEWS_BIRTHDAY_LLM=1
Environment=NEWS_BIRTHDAY_LOCALIZE=0
Environment=NEWS_BIRTHDAY_IMG_LIMIT=6
ExecStart=/usr/bin/flock -n /tmp/sitrifor-llm.lock /var/www/sitrifor/seo/scripts/news-birthday-daily.sh
Nice=15
CPUQuota=100%
MemoryMax=2G
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=3h

[Install]
WantedBy=multi-user.target
