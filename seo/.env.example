# Site
SITE_ORIGIN=https://sitrifor.ru
SITE_HOST=sitrifor.ru

# IndexNow (Bing / Yandex) — generate UUID, place same key at public/<key>.txt
INDEXNOW_KEY=

# Analytics (IDs only; snippets added in HTML separately)
YANDEX_METRIKA_ID=
GA4_MEASUREMENT_ID=

# Optional verification tokens for meta tags
YANDEX_VERIFICATION=
GOOGLE_SITE_VERIFICATION=

# Google Search Console API
GOOGLE_APPLICATION_CREDENTIALS=./credentials/gsc-service-account.json
# Domain property (preferred). Prefix alternative: https://sitrifor.ru/
GSC_SITE_URL=sc-domain:sitrifor.ru

# Yandex Webmaster API (OAuth token)
YANDEX_OAUTH_TOKEN=
YANDEX_WEBMASTER_USER_ID=

# Yandex Disk REST API — DO NOT put the token here.
# Use encrypted store via: npm run yandex:disk:auth
# Optional emergency override only with SITRIFOR_ALLOW_ENV_DISK_TOKEN=1
# YANDEX_DISK_OAUTH_TOKEN=
